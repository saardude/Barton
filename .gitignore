# dependencies
node_modules/

# build output
dist/
app/dist/
coverage/
*.tsbuildinfo
.eslintcache

# generated at build time from ../data by app/scripts/sync-data.mjs
app/public/data/
app/src/generated/

# vercel (created by `vercel link` / `vercel pull` / `vercel build`)
.vercel/

# scraper working files (raw HTML cache, never committed)
scraper/cache/

# environment files
.env
.env.*
!.env.example

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# large raw GIS downloads (regenerate with geo/build.mjs)
geo/raw/
geo/cache/

# geo: mapshaper temp dir (geo/raw/ and geo/cache/ are ignored above; geo/README.md has the
# re-download commands for every raw file)
geo/.build-tmp/

# print-source pipeline: Internet Archive OCR downloads (re-create with print/fetch.mjs)
print/raw/
