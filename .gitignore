# dependencies
node_modules/

# build output
dist/
app/dist/
coverage/
*.tsbuildinfo
.eslintcache

# generated at build time from ../data by app/scripts/sync-data.mjs
app/public/data/
app/src/generated/

# vercel (created by `vercel link` / `vercel pull` / `vercel build`)
.vercel/

# scraper working files (raw HTML cache, never committed)
scraper/cache/

# environment files
.env
.env.*
!.env.example

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# large raw GIS downloads (regenerate with geo/build.mjs)
geo/raw/
geo/cache/

# geo: raw downloads over 5 MB (see geo/README.md for how to re-download), build temp,
# local deps and the Wikidata response cache (re-created by geo/enrich-wikidata.mjs)
geo/raw/natural-earth/
geo/raw/gistory/1_MO-HOR_Shp_EPSG3857/MOTel_KP.*
geo/.build-tmp/
geo/cache/
