{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://culegeri.local/australia/schema/song.schema.json",
  "title": "Song",
  "description": "Canonical record for one song or poem indexed from folkstream.com (Australian Folk Songs, Mark Gregory). Unknown values are null, never invented. Every derived field keeps the raw text it came from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "title",
    "titleRaw",
    "titleAlt",
    "kind",
    "year",
    "author",
    "text",
    "notes",
    "provenance",
    "media",
    "location",
    "related",
    "themes",
    "warnings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^afs-[0-9]{1,4}[a-z]?$",
      "description": "Stable id: 'afs-' + the page number of the record on folkstream.com (001.html -> afs-001)."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "siteName",
        "siteId",
        "url",
        "fetchedAt"
      ],
      "properties": {
        "site": {
          "type": "string",
          "enum": [
            "afs"
          ]
        },
        "siteName": {
          "type": "string"
        },
        "siteId": {
          "type": "string",
          "minLength": 1,
          "description": "The page number as it appears in the URL."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://folkstream\\.com/",
          "description": "Record page on folkstream.com, exactly as fetched."
        },
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Title without the trailing year."
    },
    "titleRaw": {
      "type": [
        "string",
        "null"
      ],
      "description": "Title as printed in the page <title>, including the year."
    },
    "titleAlt": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other titles the songs index lists the same page under."
    },
    "kind": {
      "type": "string",
      "enum": [
        "song",
        "poem",
        "unknown"
      ],
      "description": "song when notation, a MIDI file or a tune is mentioned; poem only on an explicit signal; else unknown."
    },
    "year": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "approx",
        "from",
        "decade"
      ],
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1780,
          "maximum": 2030
        },
        "approx": {
          "type": "boolean",
          "description": "true for '1860s' or 'c. 1890' in the title."
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "title",
            "index",
            "newspaper",
            "notes",
            null
          ]
        },
        "decade": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}s$"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "raw",
        "signature"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "From 'written by X' in the notes, a 'By X' line, or a one-line signature after the last stanza."
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature": {
          "type": [
            "string",
            "null"
          ],
          "description": "A one-line final stanza such as 'H.S.B., Dunmore.' kept verbatim."
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incipit",
        "stanzas",
        "lineCount",
        "wordCount"
      ],
      "properties": {
        "incipit": {
          "type": [
            "string",
            "null"
          ]
        },
        "stanzas": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "lineCount": {
          "type": "integer",
          "minimum": 0
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "links"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mark Gregory's notes, as plain text with paragraph breaks."
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "href"
            ],
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "href": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newspaper",
        "songbooks",
        "singers",
        "collectors"
      ],
      "properties": {
        "newspaper": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "title",
            "key",
            "troveArticleId",
            "troveUrl",
            "date",
            "page",
            "stateHint",
            "context"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "description": "Folded lookup key into data/newspapers.json."
            },
            "troveArticleId": {
              "type": [
                "string",
                "null"
              ]
            },
            "troveUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "date": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "year",
                "month",
                "day",
                "raw"
              ],
              "properties": {
                "year": {
                  "type": "integer"
                },
                "month": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "day": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "raw": {
                  "type": "string"
                }
              }
            },
            "page": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stateHint": {
              "type": [
                "string",
                "null"
              ],
              "description": "The words before 'newspaper' in the notes, e.g. 'Sydney', 'Queensland'."
            },
            "context": {
              "type": [
                "string",
                "null"
              ],
              "description": "The sentence the newspaper was read from."
            }
          }
        },
        "songbooks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^book-[0-9]{3}$"
          },
          "description": "Ids into sources.json songbooks, matched by title in the notes."
        },
        "singers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "images",
        "midi",
        "audio"
      ],
      "properties": {
        "midi": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "type",
              "role",
              "width",
              "height"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "type": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "notation",
                  "masthead"
                ],
                "description": "'notation': a music scan; 'masthead': the newspaper's title banner cropped from the Trove page."
              },
              "width": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "description": "MP3 recordings embedded on the page (a handful of records)."
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "state",
        "town",
        "lat",
        "lng",
        "placeId",
        "raw"
      ],
      "properties": {
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "newspaper",
            "newspaper-state",
            null
          ],
          "description": "'newspaper': the newspaper's place of publication from the gazetteer; 'newspaper-state': only the state, from the notes' wording."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "NSW",
            "VIC",
            "QLD",
            "SA",
            "WA",
            "TAS",
            "NT",
            "ACT",
            "NZ",
            "UK",
            "US",
            null
          ]
        },
        "town": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "placeId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]+(/[a-z0-9-]+){0,2}$"
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relation",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "linked",
              "see",
              "variant"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Curated themes (data/themes.json); empty until curated."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
